# Fill locally. Never commit .env. Shell variables override this file.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
CHANNEL=append-mre
AGENT_UID=101
LISTENER_UID=103
AVATAR_UID=102
AVATAR=none
# Blank: 101 without an avatar, 102 with LemonSlice.
LISTEN_UID=

# Required by /join; the audience never publishes microphone audio.
LLM_URL=
LLM_API_KEY=
LLM_MODEL=

TTS_VENDOR=elevenlabs
TTS_KEY=
# ElevenLabs only:
ELEVENLABS_BASE_URL=wss://api.elevenlabs.io/v1
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=
# Microsoft only:
MICROSOFT_REGION=
MICROSOFT_VOICE_NAME=

# Required only for AVATAR=lemonslice. Use a public image URL.
LEMONSLICE_API_KEY=
LEMONSLICE_IMAGE_URL=

# Optional measurement tuning. RMS uses normalized decoded PCM amplitudes.
RMS_THRESHOLD=0.01
